# Public website form only. This key is visible in the browser — it is not the
# CRM login and is not PW_INTAKE_SECRET. Set the same value as Command Center
# PW_INTAKE_SITE_KEY. For local preview, point the URL at 127.0.0.1:3010.
NEXT_PUBLIC_LEAD_INTAKE_URL=https://pw-command-center.vercel.app/api/leads/intake
NEXT_PUBLIC_PW_INTAKE_SITE_KEY=

# Server-to-server Command Center intake (used by /api/lead). Never expose
# PW_INTAKE_SECRET as NEXT_PUBLIC_*. Same value as CC PW_INTAKE_SECRET.
LEAD_WEBHOOK_URL=https://pw-command-center.vercel.app/api/leads/intake
PW_INTAKE_SECRET=
